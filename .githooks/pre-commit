#!/usr/bin/env bash
set -e

# Pre-Commit Hook um die SemVer Änderung abzufragen, und anschließend automatisch die Versionsnummer in der jeweiligen Config Datei anzupassen.

# Eingabe erzwingen über Terminal (TTY), falls stdin umgeleitet ist
exec < /dev/tty

echo "----------------------------------------"
echo "SemVer Bump auswählen:"
echo "1) Patch"
echo "2) Minor"
echo "3) Major"
echo "s) Überspringen (keine Änderung)"
echo "----------------------------------------"
read -r -p "Auswahl [1/2/3/s]: " choice

BUMP=""
case "$choice" in
  1) BUMP="patch" ;;
  2) BUMP="minor" ;;
  3) BUMP="major" ;;
  s|S|"") echo "Version unverändert gelassen."; exit 0 ;;
  *) echo "Ungültige Auswahl, Commit abgebrochen."; exit 1 ;;
esac

# 1. Beispiel für pyproject.toml via Python
if [ -f "pyproject.toml" ]; then
  python3 -c "
import re, sys

part = '$BUMP'
file = 'pyproject.toml'

with open(file, 'r', encoding='utf-8') as f:
    content = f.read()

m = re.search(r'version\s*=\s*\"(\d+)\.(\d+)\.(\d+)\"', content)
if not m:
    sys.exit('Keine Version in pyproject.toml gefunden.')

major, minor, patch = map(int, m.groups())
if part == 'major':
    major, minor, patch = major + 1, 0, 0
elif part == 'minor':
    minor, minor, patch = minor + 1, 0, 0  # minor + 1, patch = 0
    minor = minor  # no-op
elif part == 'patch':
    patch += 1

new_ver = f'{major}.{minor}.{patch}'
content = re.sub(r'version\s*=\s*\"\d+\.\d+\.\d+\"', f'version = \"{new_ver}\"', content, count=1)

with open(file, 'w', encoding='utf-8') as f:
    f.write(content)

print(f'pyproject.toml: {m.group(1)}.{m.group(2)}.{m.group(3)} -> {new_ver}')
"
  git add pyproject.toml
fi

# 2. Beispiel für package.json / tsconfig-Projekte
if [ -f "package.json" ]; then
  # npm version aktualisiert package.json direkt ohne git-tag
  npm version "$BUMP" --no-git-tag-version
  git add package.json
fi

echo "Versionsdateien aktualisiert und gestaged."