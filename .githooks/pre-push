#!/bin/sh
# Git pre-push hook: faehrt lokal dieselben Pruefungen wie .github/workflows/tests.yml,
# damit ein Push nicht erst in der CI auffaellt.
#
# Reihenfolge nach Laufzeit, nicht nach Wichtigkeit: ruff und pyright brauchen
# Sekunden, der PyInstaller-Build Minuten. Frueher stand der Build vorn - ein
# einzelner Lint-Verstoss kostete damit erst den kompletten Build und fiel
# trotzdem durch. Vor pytest muss der Build aber bleiben: dist/ ist gitignored,
# und test_pyinstaller_bundle.py ueberspringt sich selbst, solange es keine
# gebaute .exe gibt.
#
# Die Befehle fuer ruff und pyright sind wortgleich zu den CI-Jobs. Dass sie es
# bleiben, prueft tests/test_git_hooks.py gegen die Workflow-Datei - genau diese
# Abweichung war der Grund, warum ein E731 lokal durchrutschte und erst in den
# GitHub Actions auffiel.

set -e

schritt() {
    echo ""
    echo "============================================================"
    echo " [pre-push] $1"
    echo "============================================================"
}

abbruch() {
    echo "" >&2
    echo "[pre-push] ❌ FEHLER: $1" >&2
    echo "[pre-push] Push wird abgebrochen." >&2
    exit 1
}

schritt "1/4: Linting (uv run ruff check src main.py tests)..."
if ! uv run ruff check src main.py tests; then
    abbruch "Linting fehlgeschlagen!"
fi

schritt "2/4: Statische Typenprüfung (uvx pyright src)..."
if ! uvx pyright src; then
    abbruch "Typecheck fehlgeschlagen!"
fi

schritt "3/4: Generiere neue .exe-Datei via PyInstaller..."
if ! uv run pyinstaller --noconfirm py-case-follow-up.spec; then
    abbruch "PyInstaller-Build fehlgeschlagen!"
fi

schritt "4/4: Führe Testsuite aus (uv run pytest --no-cov)..."
if ! uv run pytest --no-cov; then
    abbruch "Testsuite fehlgeschlagen!"
fi

echo ""
echo "============================================================"
echo " [pre-push] ✓ Lint, Typecheck, Exe-Build und alle Tests erfolgreich!"
echo " [pre-push] Push wird fortgesetzt."
echo "============================================================"
echo ""

exit 0
