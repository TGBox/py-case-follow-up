        self,
        family: str | None = ...,
        size: int | None = ...,
        weight: str | None = ...,
        slant: str | None = ...,
        underline: bool | None = ...,
        overstrike: bool | None = ...,
    ) -> None: ...

class CTk(tk.Tk):
    def __init__(self, fg_color: str | tuple[str, str] | None = ..., **kwargs: Any) -> None: ...
    def mainloop(self, n: int = 0) -> None: ...
    def destroy(self) -> None: ...
    def title(self, string: str | None = None) -> str: ...
    def geometry(self, newGeometry: str | None = None) -> str: ...
    def minsize(self, width: int | None = None, height: int | None = None) -> tuple[int, int]: ...
    def maxsize(self, width: int | None = None, height: int | None = None) -> tuple[int, int]: ...
    def resizable(self, width: bool | None = None, height: bool | None = None) -> tuple[bool, bool]: ...
    def protocol(self, name: str | None = None, func: Callable[..., Any] | None = None) -> Any: ...
    def after(self, ms: int, func: Callable[..., Any] | None = None, *args: Any) -> str: ...
    def _set_scaled_min_max(self) -> None: ...

class CTkToplevel(tk.Toplevel):
