    def resizable(self, width: bool | None = None, height: bool | None = None) -> tuple[bool, bool]: ...
    def grab_set(self) -> None: ...
    def destroy(self) -> None: ...

class CTkFrame(tk.Frame):
    def __init__(self, master: Any = None, width: int = ..., height: int = ..., corner_radius: int | None = ..., border_width: int | None = ..., bg_color: str | tuple[str, str] = ..., fg_color: str | tuple[str, str] = ..., border_color: str | tuple[str, str] = ..., cursor: str = ..., **kwargs: Any) -> None: ...
    def pack(self, **kwargs: Any) -> None: ...
    def pack_forget(self) -> None: ...
    def grid(self, **kwargs: Any) -> None: ...
    def winfo_children(self) -> Sequence[Any]: ...
    def configure(self, *args: Any, **kwargs: Any) -> None: ...

