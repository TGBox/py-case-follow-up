    def get_widget_scaling(cls, widget: Any) -> float: ...
    @classmethod
    def get_window_scaling(cls, window: Any) -> float: ...
    @classmethod
    def set_widget_scaling(cls, widget_scaling_factor: float) -> None: ...
    @classmethod
    def set_window_scaling(cls, window_scaling_factor: float) -> None: ...

class CTkFont:
